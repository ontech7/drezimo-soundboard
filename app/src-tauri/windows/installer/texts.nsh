LangString installButton ${LANG_ENGLISH} "Install"
LangString installButton ${LANG_ITALIAN} "Installa"

LangString updateTitle ${LANG_ENGLISH} "Ready to update"
LangString updateTitle ${LANG_ITALIAN} "Pronto per l'aggiornamento"
LangString updateText ${LANG_ENGLISH} "Version $InstalledVersion is installed: version ${VERSION} replaces it and keeps its settings."
LangString updateText ${LANG_ITALIAN} "È installata la versione $InstalledVersion: la ${VERSION} la sostituisce e ne mantiene le impostazioni."
LangString updateButton ${LANG_ENGLISH} "Update"
LangString updateButton ${LANG_ITALIAN} "Aggiorna"

LangString reinstallTitle ${LANG_ENGLISH} "Already installed"
LangString reinstallTitle ${LANG_ITALIAN} "Già installata"
LangString reinstallText ${LANG_ENGLISH} "Version ${VERSION} is already installed. Installing it again repairs it and keeps its settings."
