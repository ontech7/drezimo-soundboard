{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drezimo Soundboard",
  "version": "0.1.0",
  "identifier": "dev.drezimo.soundboard",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Utility",
    "publisher": "Drezimo",
    "shortDescription": "The bridge between the Drezimo board and Voicemod",
    "copyright": "2026 ontech7",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English", "Italian"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBODA3MDMyOUMzRTdBNzgKUldSNGVqNmNNbkNBYWcxQ2lRaTVoL0lHK1ptRHNEU0VWdW5wRnlKQ08xa0tTRkRxQkgwZEFqdkQK",
      "endpoints": ["https://github.com/ontech7/drezimo-soundboard/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
