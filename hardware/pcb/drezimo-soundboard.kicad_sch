	(text "DREZIMO SOUNDBOARD - rev A"
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f432709d-3cb8-5ccc-9aaf-0e8be9068a7e")
	)
	(text "36 sound pads (6x6) + 6 function keys + EC11 encoder + 1.3in SH1106 I2C OLED, RP2040-Zero (RP2040, USB-C)."
		(exclude_from_sim no)
		(at 20 24.2 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a079f65d-da99-55a0-853c-3bc59903d8e5")
	)
	(text "Powered only by the PC USB port (VBUS). LED current capped in firmware at ~400 mA total."
		(exclude_from_sim no)
		(at 20 28.4 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "78549775-cd64-564a-8861-110d83ffece0")
	)
	(text ""
		(exclude_from_sim no)
		(at 20 32.6 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "bc94d4af-36bc-54c2-89c4-294693f00b3f")
	)
	(text "KEY MATRIX: 7 rows x 6 cols, one 1N4148W per key. Diode anode on the switch side, cathode on the ROW."
		(exclude_from_sim no)
		(at 20 36.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "c79137e6-c5ee-5389-9853-cf35f1d04703")
	)
	(text "  Scan: drive one ROW low at a time, read COLs with pull-ups. Rows 0-5 = pads, row 6 = function keys."
		(exclude_from_sim no)
		(at 20 41 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8dcd4cc3-ed2a-5957-acbf-146ec96eabdb")
	)
	(text "  SW1..SW36 = pads row-major from top-left (pad index 0..35), SW37..SW42 = function keys left to right."
		(exclude_from_sim no)
		(at 20 45.2 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ae58927e-8a05-5d26-a474-7d724b32994e")
	)
	(text "  Function keys: PREV, NEXT, STOP, MUTE ME, VOICE, HEAR ME."
		(exclude_from_sim no)
		(at 20 49.4 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ba19c678-032b-5576-a1a1-5d1f6589f2bc")
	)
	(text "LEDS: SK6812MINI-E reverse mount on the PCB bottom, under each switch window (south side, 4.47 mm from centre, measured)."
		(exclude_from_sim no)
		(at 20 53.6 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "68b6e6d9-a873-5812-bae5-6beb77b5db93")
	)
	(text "  LEDn sits under SWn. Data chain order: 37 38 39 40 41 42 6 5 4 3 2 1 ..."
		(exclude_from_sim no)
		(at 20 57.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "17b432e2-73af-5e0f-bf93-dd848348d686")
	)
	(text "  i.e. function row L->R, then pad rows serpentine (row 0 R->L, row 1 L->R, ...). Firmware maps chain index -> key."
		(exclude_from_sim no)
		(at 20 62 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "c2d778da-da9d-5cab-890d-72fc6dfe515e")
	)
	(text "  GP0 (3.3 V) -> 74AHCT125 gate A (5 V out, VIH of the LED is 0.65*VDD) -> 330R -> LED chain. One 100 nF per LED."
		(exclude_from_sim no)
		(at 20 66.2 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "5339dd97-0986-5895-9e19-bb2141d91479")
	)
	(text "GPIO: COL0-5 = GP1-6, ROW0-6 = GP7-13, ENC A/B/SW = GP28/GP29/GP14, I2C1 SDA/SCL = GP26/GP27, LED data = GP0."
		(exclude_from_sim no)
		(at 20 70.4 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "67202d45-5b69-5081-8dbd-52808832b5b5")
	)
	(text "OLED J1 pin order VCC-GND-SCL-SDA, as printed on the bought module (seen from the glass side). Other modules swap VCC/GND."
		(exclude_from_sim no)
		(at 20 74.6 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "fe60fe96-4cc2-5105-863b-c7804dcf1b0d")
	)
	(text "Spare 74AHCT125 gates: OE tied high (disabled), inputs tied low. J2 = optional expansion header, spare GP15 (not fitted)."
		(exclude_from_sim no)
		(at 20 78.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "b80603c8-136f-5a2f-9c9c-6898622cc844")
	)
