(footprint "SW_MX_Hotswap_Kailh"
	(version 20260206)
	(layer "F.Cu")
	(descr "MX-style switch (5-pin) in a Kailh CPG151101S11 hot-swap socket on the bottom side (LCSC C2803348). Origin = switch centre. Pad 1 is the terminal next to the pin hole at (2.54, -5.08), pad 2 the one next to (-3.81, -2.54).")
	(tags "MX keyswitch hotswap Kailh socket")
	(property "Reference" "REF**" (at 0 -8.2 0) (layer "F.SilkS") (hide yes) (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "SW_MX_Hotswap_Kailh" (at 0 8.2 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(attr smd)
	(fp_rect (start -7.1 -7.1) (end 7.1 7.1) (stroke (width 0.12) (type solid)) (fill no) (layer "F.SilkS"))
	(fp_rect (start -7 -7) (end 7 7) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_rect (start -7.25 -7.25) (end 7.25 7.25) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_poly (pts (xy -4 -6.8) (xy 4.8 -6.8) (xy 4.8 -2.8) (xy -0.3 -2.8) (xy -1.71 -2.21) (xy -2.3 -0.8) (xy -6 -0.8) (xy -6 -4.8) (xy -5.41 -6.21)) (stroke (width 0.1) (type solid)) (fill no) (layer "B.Fab"))
	(fp_poly (pts (xy -4 -7.05) (xy 5.05 -7.05) (xy 5.05 -6.58) (xy 7.37 -6.58) (xy 7.37 -3.58) (xy 5.05 -3.58) (xy 5.05 -2.55) (xy -0.3 -2.55) (xy -2.05 -0.55) (xy -5.75 -0.55) (xy -5.75 -1.04) (xy -8.61 -1.04) (xy -8.61 -4.04) (xy -6.25 -4.04) (xy -6.25 -4.8) (xy -5.59 -6.39)) (stroke (width 0.05) (type solid)) (fill no) (layer "B.CrtYd"))
	(fp_text user "${REFERENCE}" (at 0 3.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(pad "" np_thru_hole circle (at 0 0) (size 4.0 4.0) (drill 4.0) (layers "*.Cu" "*.Mask"))
	(pad "" np_thru_hole circle (at -5.08 0) (size 1.75 1.75) (drill 1.75) (layers "*.Cu" "*.Mask"))
	(pad "" np_thru_hole circle (at 5.08 0) (size 1.75 1.75) (drill 1.75) (layers "*.Cu" "*.Mask"))
	(pad "" np_thru_hole circle (at 2.54 -5.08) (size 3.05 3.05) (drill 3.05) (layers "*.Cu" "*.Mask"))
	(pad "" np_thru_hole circle (at -3.81 -2.54) (size 3.05 3.05) (drill 3.05) (layers "*.Cu" "*.Mask"))
	(pad "1" smd roundrect (at 5.842 -5.08) (size 2.55 2.5) (layers "B.Cu" "B.Mask" "B.Paste") (roundrect_rratio 0.1))
	(pad "2" smd roundrect (at -7.085 -2.54) (size 2.55 2.5) (layers "B.Cu" "B.Mask" "B.Paste") (roundrect_rratio 0.1))
	(embedded_fonts no)
	(model "${KICAD10_3DMODEL_DIR}/Button_Switch_Keyboard.3dshapes/SW_Cherry_MX_1.00u_PCB.step"
		(offset (xyz 2.54 5.08 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
