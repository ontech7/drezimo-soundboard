(footprint "RP2040-Zero"
	(version 20260206)
	(layer "F.Cu")
	(descr "Waveshare RP2040-Zero and pin-compatible clones (AYWHP), 17.9 x 23.3 mm, mounted on 2.54 mm pin headers. Drawn from the USB-C face: place it on the bottom side so the module hangs under the board, USB face down, chip side facing the PCB. Pins measured on the real part: columns 15.24 mm, first row 1.43 mm from the USB edge, 5-pin row in line with the last column pins.")
	(tags "RP2040 Zero Waveshare module castellated")
	(property "Reference" "REF**" (at 0 5.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "RP2040-Zero" (at 0 13.15 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
